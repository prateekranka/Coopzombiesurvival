// Cloudflare Worker for rooms, relay and saves. GAME.md sections 10 and 11.
// Deploys read CLOUDFLARE_API_TOKEN from the environment. Never put the token here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lifeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "920d78e6c05a8e15380d6205aa3f38b4",
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
